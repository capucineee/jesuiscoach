# Copie ce fichier en .env pour lancer le serveur en local.
# Sur Railway, ces variables se règlent dans l'onglet "Variables" du service.

# Fournie automatiquement par le plugin PostgreSQL de Railway.
# En local : postgresql://utilisateur:motdepasse@localhost:5432/nomdebase
DATABASE_URL=

# Secret utilisé pour signer les sessions de connexion. Génère une valeur
# aléatoire (ex: `openssl rand -hex 32`) et garde-la privée.
JWT_SECRET=
